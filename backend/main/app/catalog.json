MI-20260901-UG", "name": "胸痛患者接诊（维吾尔语）", "patientName": "张建国", "department": "medicine", "subject": "心血管内科", "version": "专家审核版 v1.0 · 待专家审核", "sourceNote": "沿用胸痛病例医学资料；虚构患者阿不都热依木·艾合买提，维吾尔族，58岁，企业行政人员，籍贯新疆喀什，现居乌鲁木齐。患者只懂维吾尔语；上级医师按提问语言使用维吾尔语、中文或英文，自动复盘默认维吾尔语。界面及报告为中文。维吾尔语表达待语言教师审阅。", "materialsUrl": "case-materials/materials-mi.html", "state": "已发布", "teachers": ["测试老师01", "测试老师02", "测试老师03", "王贤帝"], "scope": false, "selfPractice": true, "trainingAvailable": true}]